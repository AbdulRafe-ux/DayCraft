# Copy this file to ".env" and replace the placeholder values.
# NEVER commit the real ".env" file to GitHub.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/daycraft for local MongoDB)
MONGODB_URI=your_mongodb_connection_string

# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# How long a login lasts, in hours
JWT_EXPIRES_HOURS=2

# The address of the React app (used for CORS)
CLIENT_URL=http://localhost:5173
